{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show *)",
      "Bash(git fetch*)",
      "Bash(git merge-base*)",
      "Bash(git add*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * merge-base*)",
      "Bash(git -C * add*)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status*)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh api:*)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl top*)",
      "Bash(helm show *)",
      "Bash(helm get *)",
      "Bash(helm search *)",
      "Bash(helm list *)",
      "Bash(kt *)",
      "Bash(sacct*)",
      "Bash(squeue*)",
      "Bash(sinfo*)",
      "Bash(sstat *)",
      "Bash(scontrol show *)",
      "Bash(sacctmgr show *)",
      "Bash(docker info*)",
      "Bash(aws s3 ls*)",
      "Bash(uv run *)",
      "Bash(uvx *)",
      "Bash(pytest*)",
      "Bash(ruff check *)",
      "Bash(pyright*)",
      "Bash(ls*)",
      "Bash(cd *)",
      "Bash(pwd*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(diff *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(base64 *)",
      "Bash(column *)",
      "Bash(sleep *)",
      "Bash(true*)",
      "Bash(date*)",
      "Bash(ps*)",
      "Bash(df*)",
      "Bash(du *)",
      "Bash(free*)",
      "Bash(w *)",
      "Bash(pstree*)",
      "Bash(lsof*)",
      "Bash(export PATH=*)",
      "Read(~/**)",
      "Grep(~/**)",
      "Glob(~/**)",
      "WebFetch(domain:lightning.ai)",
      "WebFetch(domain:arxiv.org)",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-get-comments",
      "mcp__claude_ai_Notion__notion-get-users",
      "mcp__claude_ai_Notion__notion-get-teams",
      "mcp__claude_ai_Notion__notion-query-data-sources",
      "mcp__claude_ai_Notion__notion-query-meeting-notes",
      "Bash(bash ~/.claude/skills/copy-claude-md/sync.sh*)",
      "Bash(rtk *)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/custom/hooks/caveman-activate.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/custom/hooks/rtk-ensure.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qE '(-X (DELETE|POST|PATCH|PUT)|--method[= ](DELETE|POST|PATCH|PUT)|--input)' && printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"gh api write methods blocked\"}}' || true",
            "if": "Bash(gh api:*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/custom/hooks/rtk-wrapper.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/custom/hooks/caveman-mode-tracker.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
