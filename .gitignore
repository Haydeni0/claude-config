# Ignore everything by default
*

# Track config
!.gitignore
!README.md
!CLAUDE.md
!settings.json
settings.local.json

# Track skills
!skills/
!skills/*/
!skills/**

# Track commands
!commands/
!commands/*/
!commands/**

# Track agents
!agents/
!agents/*/
!agents/**

# Track claude_md_imports
!claude_md_imports/
!claude_md_imports/*/
!claude_md_imports/**

# Track sync-opencode
!sync-opencode/
!sync-opencode/*/
!sync-opencode/**

# Track opencode-resume
!opencode-resume/
!opencode-resume/*/
!opencode-resume/**

# Track opencode base config
!opencode/
!opencode/*/
!opencode/**

# Track custom plugins and hooks
!custom/
!custom/*/
!custom/**

# Track some special commands
# From https://raba.pl/resources/claude-statusline
!statusline-command.sh

# Track RTK files
!hooks/
!hooks/**
!RTK.md