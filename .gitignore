# Ignore everything by default
*

# Track config
!.gitignore
!README.md
!CLAUDE.md
!settings.json
!settings.local.json

# Track skills
!skills/
!skills/*/
!skills/**

# Track commands
!commands/
!commands/*/
!commands/**

# Track agents
!agents/
!agents/*/
!agents/**



# Track some special commands
# From https://raba.pl/resources/claude-statusline
!statusline-command.sh